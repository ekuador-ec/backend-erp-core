LOG_LEVEL=info
PORT=3000
CORS_ORIGIN=http://localhost:5173
# PostgreSQL para Docker Compose.
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp
# Para ejecutar la API directamente en el host usa localhost:5433.
# Docker Compose sobrescribe este valor dentro del contenedor api y usa db:5432.
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5433/erp
PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=change-this-secret-with-at-least-32-characters
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN_HOURS=168
BCRYPT_SALT_ROUNDS=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Acme <your-email@gmail.com>
WHATSAPP_APICONSULT_TOKEN=your-apiconsult-token
GMAIL_API_KEY=your-gmail-api-key
